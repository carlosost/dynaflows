# Copy to .env and fill in.  .env is gitignored and must never be committed.
# Playbook 4.2: this file carries placeholders only.

# --- required ---------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-key-here
LANGSMITH_API_KEY=your-langsmith-key-here

# --- optional, with defaults ------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=dynaflows
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Runtime state. Relative paths resolve against the project root.
# DYNAFLOWS_HOME=.dynaflows

# ADR-010 / 4.5 -- every number below is a PLACEHOLDER until measured.
# OPENROUTER_MAX_CONCURRENT=8
# OPENROUTER_TIMEOUT_SECONDS=60
